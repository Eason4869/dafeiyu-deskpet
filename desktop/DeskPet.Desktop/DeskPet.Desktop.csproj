<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeskPet</AssemblyName>
    <RootNamespace>DeskPet.Desktop</RootNamespace>
    <ApplicationIcon>../../assets/pet.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <ProjectReference Include="../DeskPet.Core/DeskPet.Core.csproj" />
    <ProjectReference Include="../DeskPet.Platform.Mac/DeskPet.Platform.Mac.csproj" />
    <AvaloniaResource Include="../../assets/**/*.png" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/**/*.json" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/pet.ico" Link="Assets/pet.ico" />
  </ItemGroup>
</Project>
